          "elements": [
            {
              "className": "org.joget.apps.form.lib.CustomHTML",
              "properties": {
                "id": "customerTypeSwitchScript",
                "label": "",
                "value": "<script>\n$(document).ready(function() {\n    function clearInactiveSection(selectedType) {\n        if (selectedType === 'Individual') {\n            $('[name=customerName]').val('');\n            $('[name=registrationNumber]').val('');\n            $('[name=vatNumber]').val('');\n        } else if (selectedType === 'Corporate') {\n            $('[name=customerFirstName]').val('');\n            $('[name=customerLastName]').val('');\n            $('[name=personalId]').val('');\n        } else {\n            $('[name=customerFirstName]').val('');\n            $('[name=customerLastName]').val('');\n            $('[name=personalId]').val('');\n            $('[name=customerName]').val('');\n            $('[name=registrationNumber]').val('');\n            $('[name=vatNumber]').val('');\n        }\n        // Trigger change so concat-fields recalculate customerId and displayName\n        $('[name=personalId]').trigger('change');\n        $('[name=registrationNumber]').trigger('change');\n        $('[name=customerFirstName]').trigger('change');\n        $('[name=customerLastName]').trigger('change');\n        $('[name=customerName]').trigger('change');\n    }\n\n    $('[name=customerType]').on('change', function() {\n        clearInactiveSection($(this).val());\n    });\n});\n</script>"
              }
            }
          ]
        }
